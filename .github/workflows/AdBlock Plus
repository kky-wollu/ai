name: AdBlock Plus 每日更新

on:
  schedule:
    - cron: '0 18 * * *'
  workflow_dispatch:

jobs:
  update-rules:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    
    steps:
      - name: 检出仓库代码
        uses: actions/checkout@v3
      
      - name: 设置 Python 环境
        uses: actions/setup-python@v4
        with:
          python-version: '3.x'
      
      - name: 安装依赖
        run: pip install requests
      
      - name: 运行合并脚本
        run: python adblock_plus.py
      
      - name: 提交更新
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add adblock_plus.module
          git diff --staged --quiet || git commit -m "自动更新 AdBlock Plus 规则 $(date +'%Y-%m-%d')"
          git push
